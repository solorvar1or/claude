---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';
import { plain } from '../lib/text';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, noindex = false, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const { yandexMetrikaId: ym, gaMeasurementId: ga } = site.analytics;

const business = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: site.brand,
  legalName: site.legalName,
  url: site.url,
  telephone: plain(site.phone.display).startsWith('[') ? undefined : site.phone.tel,
  address: { '@type': 'PostalAddress', streetAddress: site.salon.street, addressLocality: site.city, addressCountry: 'BY' },
  openingHours: site.salon.hoursSchema.length ? site.salon.hoursSchema : undefined,
  areaServed: site.city,
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plain(title)}</title>
    <meta name="description" content={plain(description)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={plain(title)} />
    <meta property="og:description" content={plain(description)} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, site.url).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {ym && (
      <script is:inline define:vars={{ ym }}>
        window.__ymId = ym;
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
        window.ym(Number(ym),'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});
      </script>
    )}
    {ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>}
    {ga && (
      <script is:inline define:vars={{ ga }}>
        window.dataLayer=window.dataLayer||[];window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',ga);
      </script>
    )}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import { initForms } from '../scripts/forms';
      initForms();
    </script>
  </body>
</html>
